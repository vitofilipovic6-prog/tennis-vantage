# ─── TennisVantage Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is already in .gitignore — never commit real keys!

# Supabase (already set in src/services/supabase.js from your MaturaPrep project)
# Override here if you want a separate TennisVantage Supabase project:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# Tennis API — API-Tennis on RapidAPI (https://rapidapi.com/api-sports/api/api-tennis)
# Free tier: 100 req/day  |  Pro: $10/mo
VITE_RAPIDAPI_KEY=your_rapidapi_key_here

# AI Chat — plug in your preferred model
# VITE_ANTHROPIC_KEY=your_anthropic_key_here
# VITE_OPENAI_KEY=your_openai_key_here
